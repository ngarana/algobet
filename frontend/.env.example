# =============================================================================
# Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and modify values as needed.
# When running inside Docker, these values are overridden by docker-compose.yml

# =============================================================================
# API Configuration
# =============================================================================

# Client-side API URL
# This is used by the browser to make API requests
# When running outside Docker: use localhost with API port
# When running inside Docker (with Next.js rewrites): use relative path /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# WebSocket URL for real-time updates
# Used for WebSocket connections (e.g., live logs, progress updates)
NEXT_PUBLIC_WS_URL=ws://localhost:8010

# Server-side internal API URL
# This is used by Next.js server for API rewrites and server-side rendering
# When running outside Docker: use localhost
# When running inside Docker: use the service name (http://api:8010)
API_INTERNAL_URL=http://localhost:8010

# =============================================================================
# Application Configuration
# =============================================================================
NEXT_PUBLIC_APP_NAME=AlgoBet
NEXT_PUBLIC_APP_VERSION=1.0.0

# Enable MSW mocking for development
# Set to true to use Mock Service Worker for API mocking
NEXT_PUBLIC_ENABLE_MOCKING=false

# =============================================================================
# Development vs Production
# =============================================================================
# In production builds (docker-compose with target: runner):
# - NEXT_PUBLIC_API_URL should point to your production API
# - API_INTERNAL_URL should point to internal Kubernetes service or load balancer
#
# Example production values:
# NEXT_PUBLIC_API_URL=https://api.algobet.example.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.algobet.example.com
# API_INTERNAL_URL=http://api-service:8010
