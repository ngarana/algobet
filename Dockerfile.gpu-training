# ==============================================================================
# Dockerfile.gpu-training
# ==============================================================================
# Extends the Intel IPEX-LLM inference-cpp-xpu image to run the AlgoBet
# model training pipeline with Intel iGPU acceleration.
#
# The base image provides:
#   - Intel oneAPI 2025.0 (MKL, oneDNN, oneDAL, TBB, DPCPP compiler)
#   - Intel Level Zero GPU runtime
#   - Pre-configured SYCL environment
#   - PyTorch with XPU device support (via IPEX)
#
# We layer on top:
#   - AlgoBet Python dependencies (XGBoost, LightGBM, scikit-learn, etc.)
#   - PostgreSQL client for DB connectivity
#   - The algobet source code (bind-mounted in dev, copied in prod)
# ==============================================================================

FROM intelanalytics/ipex-llm-inference-cpp-xpu:latest

# Switch to root for package installation
USER root

# Install system dependencies needed by algobet
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    ninja-build \
    postgresql-client \
    curl \
    wget \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy dependency files first for better layer caching
COPY pyproject.toml ./
COPY uv.lock ./

# Install uv package manager
RUN pip install --no-cache-dir uv

# Install algobet project dependencies.
# The GPU worker does not need Playwright browsers, but it still imports the
# scraping router on API startup, so the Python package must be present.
# We use --system since we're inside a container and don't need a venv.
RUN uv pip install --system --no-cache \
    "playwright>=1.40.0" \
    "sqlalchemy>=2.0.0" \
    "psycopg2-binary>=2.9.9" \
    "asyncpg>=0.29.0" \
    "click>=8.0.0" \
    "python-dotenv>=1.0.0" \
    "scikit-learn>=1.3.0" \
    "lightgbm>=4.0.0" \
    "optuna>=3.4.0" \
    "numpy>=1.24.0" \
    "pandas>=2.0.0" \
    "tabulate>=0.9.0" \
    "fastapi>=0.104.0" \
    "uvicorn[standard]>=0.24.0" \
    "pydantic>=2.5.0" \
    "pydantic-settings>=2.1.0" \
    "httpx>=0.25.0" \
    "apscheduler>=3.10.0" \
    "croniter>=2.0.0" \
    "dependency-injector>=4.41.0" \
    "nest-asyncio>=1.5.0" \
    "redis>=7.4.0" \
    "fastapi-cache2>=0.2.2" \
    "jinja2>=3.1.6" \
    "joblib>=1.3.0"

ARG XGBOOST_VERSION=v3.2.0

# Build XGBoost from source with the SYCL plugin enabled.
# The PyPI wheel only exposes CUDA GPU support, so Intel iGPU training requires
# the upstream PLUGIN_SYCL build.
RUN git clone --depth 1 --branch "${XGBOOST_VERSION}" --recursive --shallow-submodules \
      https://github.com/dmlc/xgboost /tmp/xgboost && \
    cd /tmp/xgboost && \
    cmake -B build -S . \
      -DPLUGIN_SYCL=ON \
      -DGOOGLE_TEST=OFF \
      -DCMAKE_CXX_COMPILER=g++ \
      -DCMAKE_C_COMPILER=gcc \
      -GNinja && \
    cmake --build build -j"$(nproc)" && \
    python3 -m pip install --no-cache-dir --no-deps /tmp/xgboost/python-package && \
    rm -rf /tmp/xgboost

# Copy entrypoint script
COPY docker/gpu-training/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Copy application code (overridden by volume mount in dev)
COPY algobet/ ./algobet/

# Create data directory
RUN mkdir -p /app/data/models

# Environment variables for Intel iGPU (Meteor Lake / Arc A-Series)
ENV USE_XETLA=OFF
ENV ONEAPI_DEVICE_SELECTOR=level_zero:gpu
ENV SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1
ENV SYCL_CACHE_PERSISTENT=1
ENV PYTHONUNBUFFERED=1
# Override timezone from base image
ENV TZ=UTC

# Health check: verify the training worker process is alive
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import algobet; print('ok')" || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["worker"]
