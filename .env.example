# =============================================================================
# Legacy Configuration (maintained for backward compatibility)
# =============================================================================

# =============================================================================
# Algobet Environment Configuration
# =============================================================================
# Copy this file to .env and modify values as needed for your environment.
# For frontend-specific variables, also copy frontend/.env.example to frontend/.env.local

# =============================================================================
# Database Configuration (used by CLI and API)
# =============================================================================
POSTGRES_USER=algobet
POSTGRES_PASSWORD=password
POSTGRES_DB=football
# When running outside Docker: use localhost
# When running in Docker containers: use service name (algobet-db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (can be used instead of individual parameters)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://algobet:password@localhost:5432/football

# Redis Configuration
# When running outside Docker: use localhost:6379
# When running in Docker containers: use redis://algobet-redis:6379/0
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# FastAPI Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development # development | production
# CORS origins - include all frontend URLs that will access the API
# Default includes localhost ports for both old and new frontend ports
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=info # debug | info | warning | error | critical

# =============================================================================
# Frontend Environment Variables
# =============================================================================
# These should be copied to frontend/.env.local when setting up the frontend
# For Docker setup, these are configured in docker-compose.yml
#
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1  # Client-side API URL
# NEXT_PUBLIC_WS_URL=ws://localhost:8000          # WebSocket URL
# API_INTERNAL_URL=http://localhost:8000            # Server-side API URL (for rewrites)
#
# NEXT_PUBLIC_APP_NAME=AlgoBet
# NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_ENABLE_MOCKING=false # Set to true in development to use MSW mocking

# =============================================================================
# Docker Configuration Notes
# =============================================================================
# When running in Docker containers:
# - Services communicate using service names as hostnames
# - API service is accessible as 'api:8010' from other containers
# - Database is accessible as 'algobet-db:5432' from other containers
# - Redis is accessible as 'algobet-redis:6379' from other containers
# - Frontend uses API rewrites configured in next.config.js
#
# To start all services with Docker:
#   docker-compose up -d
#   docker-compose -f docker-compose.all.yml up -d  # Includes scheduler

# =============================================================================
# New Configuration System (Phase 1 Implementation)
# These settings use the new Pydantic Settings system
# =============================================================================

# Application Settings
ALGOBET_APP_NAME=AlgoBet
ALGOBET_APP_VERSION=0.1.0

# Database Configuration
ALGOBET_DATABASE__URL=postgresql://algobet:password@localhost:5432/football
ALGOBET_DATABASE__POOL_SIZE=10
ALGOBET_DATABASE__MAX_OVERFLOW=20
ALGOBET_DATABASE__ECHO=false

# Model Management
ALGOBET_MODELS__PATH=data/models
# ALGOBET_MODELS__DEFAULT_VERSION=

# Web Scraping
ALGOBET_SCRAPING__DEFAULT_URL=https://www.oddsportal.com/matches/football/
ALGOBET_SCRAPING__TIMEOUT=120
ALGOBET_SCRAPING__HEADLESS=true
ALGOBET_SCRAPING__MAX_RETRIES=3
ALGOBET_SCRAPING__RETRY_DELAY=5

# Backtesting
ALGOBET_BACKTEST__DEFAULT_MIN_MATCHES=100
ALGOBET_BACKTEST__DEFAULT_VALIDATION_SPLIT=0.2
ALGOBET_BACKTEST__MAX_HISTORY_DAYS=365

# Logging Configuration
ALGOBET_LOGGING__LEVEL=INFO
ALGOBET_LOGGING__FORMAT=text
ALGOBET_LOGGING__OUTPUT=stdout
# ALGOBET_LOGGING__FILE_PATH=logs/algobet.log
ALGOBET_LOGGING__SHOW_TIMESTAMP=true
ALGOBET_LOGGING__SHOW_LEVEL=true

# CLI Settings
ALGOBET_CLI__DEBUG=false
ALGOBET_CLI__VERBOSE=false
ALGOBET_CLI__COLOR=true

# =============================================================================
# Development Settings (uncomment for development)
# =============================================================================

# ALGOBET_LOGGING__LEVEL=DEBUG
# ALGOBET_LOGGING__FORMAT=structured
# ALGOBET_DATABASE__ECHO=true
# ALGOBET_CLI__DEBUG=true
# ALGOBET_CLI__VERBOSE=true

# =============================================================================
# Production Settings (example - uncomment for production)
# =============================================================================

# ALGOBET_LOGGING__LEVEL=WARNING
# ALGOBET_LOGGING__FORMAT=json
# ALGOBET_LOGGING__OUTPUT=file
# ALGOBET_LOGGING__FILE_PATH=/var/log/algobet/app.log
# ALGOBET_CLI__COLOR=false
